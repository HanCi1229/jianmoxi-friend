[
  {
    "name": "workspace_info",
    "title": "工作区概况",
    "description": "读取笺墨溪账号的云稿数量和作者指定的人设，开始使用插件时可先读取。不含本机草稿。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_articles",
    "title": "列出云稿",
    "description": "列出真实云稿的 ID、标题、字数和修订号；支持按标题筛选、分页和回收站。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "in_trash": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "read_article",
    "title": "读取文章",
    "description": "按 ID 分页读取作者的原文和修订号。offset/next_offset 用于继续读取，不把截取部分当全文。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "in_trash": {
          "type": "boolean"
        }
      },
      "required": [
        "article_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create_article",
    "title": "新建云稿",
    "description": "仅在用户要求保存或新建时使用。article_id 请生成一个 UUID，同一操作重试必须沿用它，防止重复建稿。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{8}(-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000
        },
        "completed": {
          "type": "boolean"
        }
      },
      "required": [
        "article_id",
        "title",
        "content"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "edit_article",
    "title": "修改云稿",
    "description": "先读原文获得 expected_revision，再按用户要求逐处替换。每个 old_text 必须在当时正文中唯一出现。冲突后重读，不能用截断内容覆盖全文。改稿只在用户明确要求保存修改时调用。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "completed": {
          "type": "boolean"
        },
        "edits": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "old_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "new_text": {
                "type": "string",
                "minLength": 0,
                "maxLength": 200000
              }
            },
            "required": [
              "old_text",
              "new_text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "article_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "trash_article",
    "title": "文章移入回收站",
    "description": "仅在用户明确要求删除该文章时，按刚读取的修订号移入回收站。可用 restore_article 恢复。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "article_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "restore_article",
    "title": "恢复文章",
    "description": "按回收站列表中的 ID 和修订号恢复文章。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "article_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "article_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "search_library",
    "title": "搜索书库",
    "description": "按书名、作者或文集检索已有书库，返回真实作品 ID 和来源。正文按章节读取。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "author": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "read_library",
    "title": "阅读原文",
    "description": "读取指定作品和章节的真实原文、目录、来源。chapter 从 0 开始。用 next_offset 续读长章节，引用限于实际读到的内容。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "chapter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "work_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_excerpts",
    "title": "查找摘录",
    "description": "检索当前账号收藏的书库摘录，返回原句、作者、作品和章节。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "save_excerpt",
    "title": "收藏摘录",
    "description": "用户要求收藏时使用。text 必须是 read_library 读到的对应章节原文，服务端逐字核验。相同原句重复收藏不会新增。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "chapter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "text": {
          "type": "string",
          "minLength": 4,
          "maxLength": 3000
        }
      },
      "required": [
        "work_id",
        "text"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "migration_import",
    "title": "迁移导入（临时）",
    "description": "当前所有者已授权迁移的专用入口，将旧数据导入私人托管存储。完成后关闭，不用于普通聊天。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "payload"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "start",
            "objects",
            "part",
            "finish_object",
            "workspace",
            "works",
            "complete",
            "status"
          ]
        },
        "payload": {
          "type": "string",
          "maxLength": 900000
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
